{
  "name": "@freegent/cloudflare-native",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "bun run types && bun run typecheck && bun run test && bun run deploy:dry",
    "dashboard:token": "test -n \"$CLOUDFLARE_API_KEY\" && printf 'freegent-native-dashboard-v2:%s' \"$CLOUDFLARE_API_KEY\" | shasum -a 256 | awk '{print $1}'",
    "deploy": "wrangler deploy",
    "deploy:dry": "wrangler deploy --dry-run",
    "dev": "wrangler dev",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "types": "wrangler types"
  },
  "dependencies": {
    "@cfworker/json-schema": "4.1.1",
    "zod": "^4.0.10"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "vitest": "^3.2.4",
    "wrangler": "^4.26.0"
  }
}
